# The timezone the studio schedules in, as an IANA name. The timeline reads every task date
# in this zone, so a task lands on the same day for every viewer wherever they are.
# ftrack does not publish this through its API, so it has to be stated here. Leave it unset
# to use America/Los_Angeles. Same setting as ftrack-timeline-viewer.
VITE_STUDIO_TIME_ZONE=America/Los_Angeles
